# Technical environment variables only. Never place Business policy values or secrets here.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_academy
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Provider-neutral object-storage configuration. Provider selection requires an ADR.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
